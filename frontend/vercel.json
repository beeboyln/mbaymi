{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/assets/images/(.*)", "destination": "/assets/assets/images/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
