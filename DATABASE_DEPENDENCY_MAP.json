  "python_deletion_function_pseudocode": {
    "description": "Recommended order for Python/SQLAlchemy deletion",
    "note": "Some items use CASCADE and will auto-delete; others require manual deletion",
    "execution_order": [
      "1. Delete FarmPostLike (cascade from FarmImagePost)",
      "2. Delete FarmPostComment (cascade from FarmImagePost)",
      "3. Delete FarmPostShare (cascade from FarmImagePost)",
      "4. Delete ActivityPhoto (cascade from Activity)",
      "5. Delete AnimalPhoto (only if deleting livestock too)",
      "6. Delete Consultation (manual, depends on ServiceRequest)",
      "7. Delete Sale (manual, depends on Harvest)",
