  "deletion_order_for_farm": {
    "instructions": "Follow this order exactly when deleting ALL farm data. Some steps can be parallelized where noted.",
    "total_steps": 22,

    "deletion_phases": [
      {
        "phase": "PHASE 1: Delete leaf-level entities (no dependents)",
        "steps": [
          {
            "order": 1,
            "model": "FarmPostLike",
            "depends_on": "FarmImagePost",
            "cascade_from_parent": true,
            "manual_query": "DELETE FROM farm_post_likes WHERE farm_post_id IN (SELECT id FROM farm_image_posts WHERE farm_id = ?)"
          },
          {
            "order": 2,
            "model": "FarmPostComment",
            "depends_on": "FarmImagePost",
            "cascade_from_parent": true,
            "manual_query": "DELETE FROM farm_post_comments WHERE farm_post_id IN (SELECT id FROM farm_image_posts WHERE farm_id = ?)"
          },
          {
            "order": 3,
            "model": "FarmPostShare",
            "depends_on": "FarmImagePost",
            "cascade_from_parent": true,
            "manual_query": "DELETE FROM farm_post_shares WHERE farm_post_id IN (SELECT id FROM farm_image_posts WHERE farm_id = ?)"
          },
          {
            "order": 4,
            "model": "ActivityPhoto",
            "depends_on": "Activity",
            "cascade_from_parent": true,
            "manual_query": "DELETE FROM activity_photos WHERE activity_id IN (SELECT id FROM activities WHERE farm_id = ?)"
          },
          {
            "order": 5,
            "model": "AnimalPhoto",
            "depends_on": "Livestock (user-owned, not farm-owned)",
            "cascade_from_parent": true,
            "note": "Only delete if livestock is being deleted",
            "manual_query": "DELETE FROM animal_photos WHERE livestock_id IN (SELECT id FROM livestock WHERE user_id = ?)"
          }
        ],
        "can_parallelize": true
      },

      {
        "phase": "PHASE 2: Delete dependent entities (still have parents)",
        "steps": [
          {
            "order": 6,
            "model": "Consultation",
            "depends_on": "ServiceRequest",
            "cascade_from_parent": false,
            "requires_manual_deletion": true,
